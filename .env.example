# Environment Configuration for Demand Forecasting & Inventory Optimization
ENVIRONMENT=development
LOG_LEVEL=INFO

# Data Storage Settings
DATA_RAW_DIR=data/raw
DATA_PROCESSED_DIR=data/processed
OUTPUT_DIR=outputs
MODELS_DIR=models

# Database Configuration
DUCKDB_PATH=data/processed/analytics.duckdb

# Default Inventory Scenario Parameters
DEFAULT_SERVICE_LEVEL=0.95
DEFAULT_LEAD_TIME_DAYS=7
DEFAULT_REVIEW_PERIOD_DAYS=7
DEFAULT_HOLDING_COST_RATE=0.25
DEFAULT_STOCKOUT_PENALTY_MULT=2.5
